from __future__ import annotations

class RawCondition:
    @staticmethod
    def always() -> RawCondition: ...
    @staticmethod
    def never() -> RawCondition: ...
    @staticmethod
    def deaths(player: int, comparison: int, amount: int, unit: int) -> RawCondition: ...
    @staticmethod
    def deaths_x(
        player: int, comparison: int, amount: int, unit: int, mask: int
    ) -> RawCondition: ...
    @staticmethod
    def memory(address: int, comparison: int, value: int) -> RawCondition: ...
    @staticmethod
    def memory_x(
        address: int, comparison: int, value: int, mask: int
    ) -> RawCondition: ...
    @staticmethod
    def var_cmp(
        var_id: int, comparison: int, value: int, mask: int | None = None
    ) -> RawCondition: ...
    @staticmethod
    def accumulate(
        player: int, comparison: int, amount: int, resource: int
    ) -> RawCondition: ...
    @staticmethod
    def command(
        player: int, comparison: int, amount: int, unit: int
    ) -> RawCondition: ...
    @staticmethod
    def bring(
        player: int, comparison: int, amount: int, unit: int, location: int
    ) -> RawCondition: ...
    @staticmethod
    def switch(switch_id: int, state: int) -> RawCondition: ...

class RawAction:
    @staticmethod
    def set_deaths(player: int, modifier: int, value: int, unit: int) -> RawAction: ...
    @staticmethod
    def set_deaths_x(
        player: int, modifier: int, value: int, unit: int, mask: int
    ) -> RawAction: ...
    @staticmethod
    def set_memory(address: int, modifier: int, value: int) -> RawAction: ...
    @staticmethod
    def set_memory_x(
        address: int, modifier: int, value: int, mask: int
    ) -> RawAction: ...
    @staticmethod
    def set_var_const(
        var_id: int, modifier: int, value: int, mask: int | None = None
    ) -> RawAction: ...
    @staticmethod
    def set_resources(
        player: int, modifier: int, amount: int, resource: int
    ) -> RawAction: ...
    @staticmethod
    def display_text(text: str, always_display: bool = True) -> RawAction: ...
    @staticmethod
    def display_text_id(string_id: int, always_display: bool = True) -> RawAction: ...
    @staticmethod
    def create_unit(count: int, unit: int, location: int, player: int) -> RawAction: ...
    @staticmethod
    def comment(text: str) -> RawAction: ...
    @staticmethod
    def preserve_trigger() -> RawAction: ...
    @staticmethod
    def victory() -> RawAction: ...
    @staticmethod
    def defeat() -> RawAction: ...

class CompilationReport:
    @property
    def trigger_count(self) -> int: ...
    @property
    def byte_buf_count(self) -> int: ...
    @property
    def vproc_count(self) -> int: ...
    @property
    def payload_offset(self) -> int: ...
    @property
    def payload_size(self) -> int: ...
    @property
    def payload_entry_addr(self) -> int: ...
    @property
    def prt_count(self) -> int: ...
    @property
    def ort_count(self) -> int: ...

class RawSession:
    def __init__(
        self,
        map_path: str,
        obscurate: bool = False,
        obscurate_seed: int | None = None,
        preserve_classic_triggers: bool = True,
    ) -> None: ...
    def location_id(self, name: str) -> int: ...
    def unit_id(self, name: str) -> int: ...
    def switch_id(self, name: str) -> int: ...
    def get_or_insert_string(self, text: str) -> int: ...
    def classic_trigger_count(self) -> int: ...
    def strx_byte_len(self) -> int: ...
    def locations_count(self) -> int: ...
    def placed_units_count(self) -> int: ...
    def add_var(self, name: str, init_val: int) -> int: ...
    def add_byte_buf(self, name: str, data: bytes) -> int: ...
    def begin_function(self, name: str, is_main_loop: bool = True) -> None: ...
    def end_function(self) -> int: ...
    def begin_if(self, conditions: list[RawCondition]) -> None: ...
    def end_if(self) -> None: ...
    def begin_elif(self, conditions: list[RawCondition]) -> None: ...
    def end_elif(self) -> None: ...
    def begin_else(self) -> None: ...
    def end_else(self) -> None: ...
    def begin_while(self, conditions: list[RawCondition]) -> None: ...
    def end_while(self) -> None: ...
    def push_break(self) -> None: ...
    def push_continue(self) -> None: ...
    def push_var_assign(self, var_id: int, value: int) -> None: ...
    def push_var_add(self, var_id: int, value: int) -> None: ...
    def push_var_sub(self, var_id: int, value: int) -> None: ...
    def push_var_set_mask(
        self, var_id: int, modifier: int, value: int, mask: int
    ) -> None: ...
    def push_action(self, action: RawAction) -> None: ...
    def push_trigger(
        self,
        conditions: list[RawCondition],
        actions: list[RawAction],
        label: str | None = None,
        preserved: bool = True,
    ) -> None: ...
    def dump_hir(self) -> str: ...
    def dump_lir(self) -> str: ...
    def compile(self, output_path: str) -> CompilationReport: ...
