{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "eudkit": ["../../../../packages/ts-sdk/src/index.ts"]
    }
  },
  "include": ["typescript/**/*.ts", "javascript/**/*.js"]
}
